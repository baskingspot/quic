.{
    .name = .quic,
    .version = "0.0.0",
    .fingerprint = 0xc07952529a100bdf, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // The TLS 1.3 handshake the quic-tls driver runs over. Built by
        // default. `-Dno-tls` still fetches it, because a dependency is fetched
        // before any option is read, but never configures or compiles it.
        // v0.4.0 is the first release that builds on Zig 0.17 and the first
        // without the libxev dependency, whose build script does not compile on
        // 0.17: as a fetched dependency it reached the configurer even with
        // xev unused, and stopped the build before a line of ours ran.
        //
        // The driver needs the #179 surface: transport parameters in both
        // directions, a server's application secrets, and a public `KeyPairs`.
        .tls = .{
            .url = "https://baskingspot.dev/tls/v0.4.6.tar.gz",
            .hash = "tls-0.4.6-nf2MKL2lQgC8YdPb9L-G2pzigRSo1YRrOXzJ8Rjw3vKR",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
